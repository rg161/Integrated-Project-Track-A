<mujoco model="scene_env">
    <compiler assetdir="assets"/>
    <option integrator="Euler" timestep="0.002"/>

    <worldbody>
        <!-- The Ground Floor -->
        <geom name="floor" type="plane" size="5.0 5.0 0.1" rgba="0.8 0.8 0.8 1"/>

        <!-- Light Source -->
        <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1"/>

        <!-- Charging Station -->
        <geom name="charging_station" type="box" size="0.2 0.2 0.2" pos="1.5 2 0" rgba="1 1 1 1"/>

        <!-- Robot -->
        <body name="robot" pos="0 0 0.1">
            <geom name="robot_geom" type="sphere" size="0.1" rgba="0 0 1 1"/>
        </body>
    </worldbody>
</mujoco>